# ============================================
# Masar Student Platform — Environment Variables Example
# ============================================

# Managed PostgreSQL Database Connection String (Supabase / Neon)
DATABASE_URL="postgresql://user:password@host:5432/masar?sslmode=require"

# Moodle Token AES-256 Encryption Key (64-character hex string = 32 bytes)
MOODLE_TOKEN_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# HTTP Basic Auth for /moodle-test restricted area
MOODLE_TEST_USER="admin"
MOODLE_TEST_PASSWORD="your-secure-test-password"
MOODLE_TEST_ENABLED="true"