# ============================================
# Masar Platform — Environment Variables Example
# ============================================

# 1. Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# 2. Authentication & JWT Session Secret
JWT_SECRET="generate-a-strong-32-byte-hex-secret-here"

# 3. Moodle & Data Encryption Key (AES-256-GCM, 32 bytes hex)
MOODLE_TOKEN_ENCRYPTION_KEY="generate-a-64-character-hex-string-for-aes-256"

# 4. Optional Moodle Test Credentials
MOODLE_TEST_USER="student_username"
MOODLE_TEST_PASSWORD="student_password"

# 5. Microsoft Teams Integration (OAuth 2.0 / Azure AD)
# Scope required: Calendars.Read (Delegated only)
MS_TEAMS_CLIENT_ID=""
MS_TEAMS_CLIENT_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 6. Web Push Notifications (VAPID Keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@masar.edu.jo"

# 7. AI Engine (Google Gemini Flash / DeepSeek / OpenAI)
GOOGLE_GENERATIVE_AI_API_KEY=""
DEEPSEEK_API_KEY=""
